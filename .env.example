# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=
# Model choice: gemini-3.5-transcribe-live (August 2026 Speech Flagship) or gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-transcribe-live

# Server Ports
PORT=3001
VITE_PORT=3000

# Environment (development / production)
NODE_ENV=development
