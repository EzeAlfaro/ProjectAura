# ==========================================
# Project Aura - Environment Configuration
# ==========================================

# 1. Google Gemini AI Engine
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_ENABLE_35PRO=false
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# Security & Operator Access
# If set, mutating endpoints (key configuration, room blackout, emergency delete, remote reload)
# require this token via 'x-admin-token' header or '?key=...' query parameter.
# If left empty, system operates in open demo mode.
ADMIN_TOKEN=nerdearla2026-demo

# 2. Local Edge AI (Ollama / Google Gemma 2)
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:2b

# 3. Fallback Translation Engine
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_CONTACT_EMAIL=support@projectaura.io

# 4. Networking & Ports
PORT=3001
VITE_PORT=3000
HOST=0.0.0.0
WS_PATH=/ws
CORS_ORIGIN=*
USE_SSL=false

# 5. Conference & Venue Identity
EVENT_NAME=Nerdearla 2026
EVENT_CITY=Buenos Aires
EVENT_VENUE=Ciudad Cultural Konex

# 6. Environment Mode
NODE_ENV=development
