# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=
# Model choice: gemini-3.5-transcribe-live (Google Live Streaming Flagship), gemini-3.5-flash, or gemini-3.5-pro
GEMINI_MODEL=gemini-3.5-transcribe-live
GEMINI_PRO_MODEL=gemini-3.5-pro

# Server Ports
PORT=3001
VITE_PORT=3000

# Environment (development / production)
NODE_ENV=development
